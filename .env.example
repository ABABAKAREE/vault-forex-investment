PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vault_invest
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=12h

APP_ORIGIN=http://localhost:3000

# Provider mode: live | mock
PAYMENT_PROVIDER_MODE=mock

# Shared webhook secret expected in header x-webhook-signature (HMAC SHA256 of raw body)
PAYMENT_WEBHOOK_SECRET=change-this-webhook-secret

# Optional provider API configuration (used when PAYMENT_PROVIDER_MODE=live)
AZAMPAY_AUTH_URL=
AZAMPAY_BASE_URL=
AZAMPAY_API_KEY=
AZAMPAY_DEPOSIT_PATH=
AZAMPAY_WITHDRAW_PATH=

INTASEND_BASE_URL=
INTASEND_API_KEY=
INTASEND_DEPOSIT_PATH=
INTASEND_WITHDRAW_PATH=

FLUTTERWAVE_BASE_URL=
FLUTTERWAVE_API_KEY=
FLUTTERWAVE_DEPOSIT_PATH=
FLUTTERWAVE_WITHDRAW_PATH=
NOWPAYMENTS_IPN_SECRET=
